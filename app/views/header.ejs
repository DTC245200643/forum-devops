<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Diễn đàn</title>
<style>
:root{--bg:#f6f7fb;--card:#fff;--text:#111827;--muted:#6b7280;--line:#e5e7eb;--p:#4f46e5;--p2:#7c3aed;--pl:#eef2ff}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.65 -apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif}
a{color:var(--p);text-decoration:none}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}
.nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.88);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:68px}
.brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:1.25rem;color:var(--text)}
.brand:hover{color:var(--text)}
.logo{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,var(--p),var(--p2));display:flex;align-items:center;justify-content:center;font-size:1.2rem}
.nav-r{display:flex;align-items:center;gap:10px}
.nl{color:#374151;font-weight:500;padding:8px 14px;border-radius:10px}
.nl:hover{background:var(--pl);color:var(--p)}
.btn{display:inline-block;background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;border:0;border-radius:10px;padding:10px 20px;font:inherit;font-weight:600;cursor:pointer;transition:.2s}
.btn:hover{transform:translateY(-2px);box-shadow:0 10px 20px rgba(79,70,229,.3);color:#fff}
.btn.ghost{background:#fff;color:var(--p);border:1px solid var(--line)}
.btn.ghost:hover{background:var(--pl);box-shadow:none;color:var(--p)}
.btn.full{width:100%;text-align:center}
.me{display:flex;align-items:center;gap:8px;font-weight:600}
.av{flex:none;width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700}
.av.sm{width:34px;height:34px;font-size:.9rem}
.hero{position:relative;overflow:hidden;border-radius:24px;padding:56px 48px;margin:32px 0;color:#fff;background:radial-gradient(circle at 85% 20%,rgba(255,255,255,.22),transparent 40%),radial-gradient(circle at 10% 95%,rgba(255,255,255,.14),transparent 45%),linear-gradient(135deg,#4f46e5,#7c3aed 60%,#db2777)}
.hero h1{margin:0 0 10px;font-size:2.6rem;line-height:1.15;letter-spacing:-.5px}
.hero p{margin:0 0 24px;font-size:1.15rem;opacity:.92;max-width:560px}
.stats{display:flex;gap:14px;flex-wrap:wrap}
.stat{background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.3);border-radius:14px;padding:10px 22px}
.stat b{display:block;font-size:1.5rem;line-height:1.2}
.stat span{font-size:.85rem;opacity:.9}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:28px;align-items:start}
.side{position:sticky;top:92px;display:flex;flex-direction:column;gap:20px}
h2.sec{font-size:1.35rem;margin:0 0 16px;display:flex;align-items:center;gap:8px}
h3{margin:0 0 12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:0 1px 2px rgba(17,24,39,.04)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px;margin-bottom:36px}
.c0{--a:#4f46e5;--al:#eef2ff}.c1{--a:#7c3aed;--al:#f5f3ff}.c2{--a:#059669;--al:#ecfdf5}.c3{--a:#ea580c;--al:#fff7ed}.c4{--a:#db2777;--al:#fdf2f8}
.tc{display:block;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px;color:inherit;transition:.25s;position:relative;overflow:hidden}
.tc:before{content:"";position:absolute;left:0;top:0;right:0;height:5px;background:var(--a,#4f46e5)}
.tc:hover{transform:translateY(-6px);box-shadow:0 18px 30px rgba(17,24,39,.12);color:inherit}
.ti{width:50px;height:50px;border-radius:14px;background:var(--al,#eef2ff);color:var(--a,#4f46e5);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1.4rem;margin-bottom:14px}
.tc h3{margin:0 0 8px;font-size:1.1rem}
.pill{display:inline-block;background:var(--al,#eef2ff);color:var(--a,#4f46e5);border-radius:999px;padding:2px 12px;font-size:.8rem;font-weight:700}
.meta{color:var(--muted);font-size:.85rem;margin-top:10px}
.row{display:flex;gap:14px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px 20px;margin-bottom:12px;color:inherit;transition:.2s}
.row:hover{border-color:var(--p);box-shadow:0 10px 22px rgba(79,70,229,.12);transform:translateX(4px);color:inherit}
.rt{font-weight:700;font-size:1.05rem;margin-bottom:2px}
.muted{color:var(--muted);font-size:.88rem}
.sl a{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;border-radius:12px;color:var(--text);font-weight:500}
.sl a:hover{background:var(--pl);color:var(--p)}
.sl small{background:#f3f4f6;border-radius:999px;padding:1px 10px;color:var(--muted);font-weight:600}
label{font-weight:600;font-size:.9rem}
input,textarea{width:100%;padding:12px 14px;margin:6px 0 14px;border:1px solid #d1d5db;border-radius:12px;font:inherit;background:#fff;transition:.15s}
input:focus,textarea:focus{outline:none;border-color:var(--p);box-shadow:0 0 0 4px rgba(79,70,229,.15)}
.err{background:#fef2f2;color:#b91c1c;border:1px solid #fecaca;padding:10px 14px;border-radius:12px;margin-bottom:14px}
.crumb{margin:26px 0 14px;font-size:.92rem}
.ph{border-radius:22px;padding:36px;color:#fff;margin-bottom:26px;background:linear-gradient(135deg,var(--a,#4f46e5),#111827 190%)}
.ph h1{margin:0 0 6px;font-size:2rem}
.ph span{opacity:.9}
.art h1{font-size:2rem;line-height:1.25;margin:0 0 16px}
.by{display:flex;gap:12px;align-items:center;padding-bottom:18px;margin-bottom:18px;border-bottom:1px solid var(--line)}
.body{white-space:pre-wrap;font-size:1.08rem;line-height:1.8;margin:0}
.cm{display:flex;gap:12px;margin-bottom:14px}
.bub{flex:1;background:var(--card);border:1px solid var(--line);border-radius:4px 16px 16px 16px;padding:12px 18px}
.bub b{margin-right:8px}
.empty{text-align:center;color:var(--muted);padding:32px;background:var(--card);border:2px dashed var(--line);border-radius:18px;margin-bottom:16px}
.authw{max-width:440px;margin:56px auto}
.authw .card{padding:36px;box-shadow:0 20px 40px rgba(17,24,39,.08)}
.authw h1{margin:0 0 18px}
main{padding-bottom:20px}
footer{text-align:center;color:var(--muted);font-size:.88rem;padding:36px 0 48px}
@media(max-width:900px){.layout{grid-template-columns:1fr}.side{position:static}.hero{padding:36px 24px}.hero h1{font-size:2rem}}
@media(max-width:560px){.me span{display:none}.wrap{padding:0 16px}}
</style>
</head>
<body>
<nav class="nav"><div class="wrap">
  <a class="brand" href="/"><span class="logo">💬</span>Diễn đàn</a>
  <div class="nav-r">
    <a class="nl" href="/">Trang chủ</a>
    <% if (user) { %>
      <div class="me"><div class="av sm"><%= user.username.charAt(0).toUpperCase() %></div><span><%= user.username %></span></div>
      <a class="btn ghost" href="/logout">Đăng xuất</a>
    <% } else { %>
      <a class="nl" href="/login">Đăng nhập</a>
      <a class="btn" href="/register">Đăng ký</a>
    <% } %>
  </div>
</div></nav>
<main class="wrap">
