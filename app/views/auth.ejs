<%- include('header') %>
<% const isReg = (action === '/register'); %>
<div class="authw">
  <form class="card" method="post" action="<%= action %>">
    <h1><%= isReg ? 'Tạo tài khoản' : 'Chào mừng trở lại' %></h1>
    <% if (error) { %><div class="err"><%= error %></div><% } %>
    <label>Tên đăng nhập</label>
    <input name="username" placeholder="Nhập tên đăng nhập" required>
    <label>Mật khẩu</label>
    <input name="password" type="password" placeholder="Nhập mật khẩu" required>
    <button class="btn full"><%= isReg ? 'Đăng ký' : 'Đăng nhập' %></button>
    <p class="muted" style="text-align:center;margin:16px 0 0">
      <% if (isReg) { %>Đã có tài khoản? <a href="/login">Đăng nhập</a>
      <% } else { %>Chưa có tài khoản? <a href="/register">Đăng ký</a><% } %>
    </p>
  </form>
</div>
<%- include('footer') %>
